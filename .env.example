# ==========================================================
# PREVENIA - Environment Variables (Root Template)
# ==========================================================

# Environment mode (local, development, staging, production)
ENVIRONMENT=local

# ----------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------
POSTGRES_DB=prevenia
POSTGRES_USER=prevenia
POSTGRES_PASSWORD=prevenia_local_secret
POSTGRES_PORT=5432
DB_HOST=postgres

# ----------------------------------------------------------
# Backend Configuration (Spring Boot)
# ----------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MINUTES=1440

# Bootstrap initial master admin user on clean database startup (used in prod)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@prevenia.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeInProd2026!
BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
BOOTSTRAP_ADMIN_LAST_NAME=Principal
BOOTSTRAP_ADMIN_ORG_NAME=Consultora Principal
BOOTSTRAP_ADMIN_ROLE=CONSULTANT_ADMIN

# ----------------------------------------------------------
# Frontend Configuration (Next.js)
# ----------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
